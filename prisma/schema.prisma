datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

model Product {
  id                  Int            @id @default(autoincrement())
  source_site         String
  title               String
  category            String?
  description         String?
  image_url           String         @default("")
  cash_price          Decimal
  installment_price   Decimal
  installments_count  Int            @default(1)
  coupon              String?
  product_url         String         @unique
  store_url           String?
  created_at          DateTime       @default(now())
  specs               Json?
  price_histories     PriceHistory[]
  offers              Offer[]

  @@map("products")
}

model PriceHistory {
  id                  Int      @id @default(autoincrement())
  product_id          Int
  product             Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  date                DateTime
  price               Decimal
  installment_price   Decimal?

  @@unique([product_id, date])
  @@map("price_histories")
}

model Offer {
  id                  Int      @id @default(autoincrement())
  product_id          Int
  product             Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  store_name          String
  cash_price          Decimal
  installment_price   Decimal
  installments_count  Int      @default(1)
  store_url           String
  image_url           String?
  created_at          DateTime @default(now())

  @@map("offers")
}



